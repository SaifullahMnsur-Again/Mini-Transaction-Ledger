# ==========================================
# MiniTransactionLedger Environment Variables
# ==========================================
# Copy this file to .env and update with your values
# DO NOT commit .env file to git (add to .gitignore)

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=ledger_db

# ==========================================
# APPLICATION ENVIRONMENT
# ==========================================
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production

# Options: Development, Staging, Production
# Development: More verbose logging, debug features enabled
# Staging: Production-like environment for testing
# Production: Optimized for performance, minimal logging

# ==========================================
# DOMAIN CONFIGURATION
# ==========================================
DOMAIN=your-domain.com
# Example: ledger.yourdomain.com

# ==========================================
# BACKEND (.NET) CONFIGURATION
# ==========================================
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTPS_PORT=8081

# Logging
LOG_LEVEL=Information
# Options: Trace, Debug, Information, Warning, Error, Critical

# CORS (Cross-Origin Resource Sharing)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ==========================================
# FRONTEND (REACT) CONFIGURATION
# ==========================================
REACT_APP_API_URL=https://your-domain.com/api
REACT_APP_APP_NAME=MiniTransactionLedger

# ==========================================
# NGINX CONFIGURATION
# ==========================================
# These are baked into nginx.conf, but documented here
MAX_BODY_SIZE=20M
WORKER_PROCESSES=auto

# ==========================================
# SSL/CERTIFICATE CONFIGURATION
# ==========================================
# Let's Encrypt Email (for certificate renewal notifications)
LETSENCRYPT_EMAIL=your-email@example.com
LETSENCRYPT_DOMAIN=your-domain.com

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Enable detailed request logging
ENABLE_REQUEST_LOGGING=true

# Docker log driver
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ==========================================
# OPTIONAL: ADDITIONAL SERVICES
# ==========================================
# Redis (if implementing caching)
# REDIS_HOST=redis
# REDIS_PORT=6379

# ElasticSearch (if implementing advanced logging)
# ELASTICSEARCH_HOST=elasticsearch
# ELASTICSEARCH_PORT=9200

# SendGrid (if implementing email service)
# SENDGRID_API_KEY=your_sendgrid_key

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# API Rate Limiting
API_RATE_LIMIT=10r/s
GENERAL_RATE_LIMIT=50r/s

# Session Configuration
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# ==========================================
# PERFORMANCE TUNING
# ==========================================
# Database connection pool
DB_POOL_SIZE=20
DB_POOL_MIN=5

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 hour in seconds

# ==========================================
# DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# ==========================================
# DEBUG_MODE=false
# ALLOW_SWAGGER_UI=false
# ALLOW_DATABASE_RESET=false