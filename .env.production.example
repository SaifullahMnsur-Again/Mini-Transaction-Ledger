# ================================================================
# MINI TRANSACTION LEDGER - ENVIRONMENT VARIABLES TEMPLATE
# ================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub (keep in .gitignore)
# ================================================================

# ================================================================
# DATABASE CONFIGURATION
# ================================================================
# PostgreSQL credentials - change these to secure values
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_SecurePassword123!
POSTGRES_DB=ledger_db

# Database optimization for 1GB RAM VM
# Don't change these unless you understand impact
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_EFFECTIVE_CACHE_SIZE=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=16MB

# ================================================================
# APPLICATION ENVIRONMENT
# ================================================================
# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Production

# Node.js environment
NODE_ENV=production

# ================================================================
# DOMAIN & SSL CONFIGURATION
# ================================================================
# Your domain name (e.g., ledger.example.com)
DOMAIN=your-domain.com

# Alternative domain (e.g., www.your-domain.com)
DOMAIN_ALT=www.your-domain.com

# Email for SSL certificate notifications (Let's Encrypt)
LETSENCRYPT_EMAIL=your-email@example.com

# ================================================================
# DOCKER & CONTAINER CONFIGURATION
# ================================================================
# Compose project name (affects container names)
COMPOSE_PROJECT_NAME=ledger

# ================================================================
# BACKEND API CONFIGURATION
# ================================================================
# API base URL (for frontend API calls)
REACT_APP_API_URL=https://${DOMAIN}/api

# API port (internal only, not exposed)
BACKEND_PORT=8080

# ================================================================
# FRONTEND CONFIGURATION
# ================================================================
# Frontend port (internal only, not exposed)
FRONTEND_PORT=3000

# ================================================================
# NGINX CONFIGURATION
# ================================================================
# Nginx worker processes (auto = CPU count)
NGINX_WORKERS=auto

# Nginx worker connections
NGINX_WORKER_CONNECTIONS=1024

# Max upload size (in nginx client_max_body_size)
MAX_UPLOAD_SIZE=10m

# Enable/disable rate limiting (yes/no)
ENABLE_RATE_LIMITING=yes

# ================================================================
# LOGGING CONFIGURATION
# ================================================================
# Docker log max size per container
LOG_MAX_SIZE=5m

# Docker log max file count
LOG_MAX_FILE=2

# Application log level (Debug/Information/Warning/Error/Critical)
LOG_LEVEL=Information

# ================================================================
# BACKUP CONFIGURATION
# ================================================================
# Enable automatic backups (yes/no)
ENABLE_BACKUPS=yes

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format) - default: daily at 2 AM
# Example: 0 2 * * * (every day at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# ================================================================
# SECURITY CONFIGURATION
# ================================================================
# CORS allowed origins (comma-separated)
# Example: https://localhost:3000,https://example.com
CORS_ALLOWED_ORIGINS=https://${DOMAIN}

# Enable HTTPS strict mode
ENABLE_HSTS=yes

# Enable security headers
ENABLE_SECURITY_HEADERS=yes

# ================================================================
# PERFORMANCE CONFIGURATION
# ================================================================
# .NET Tiered Compilation (for faster startup on low-RAM)
DOTNET_TIERED_COMPILATION=1
DOTNET_TIERED_COMPILATION_QUICK_JIT=1

# Enable Gzip compression
ENABLE_GZIP_COMPRESSION=yes

# Cache expiry times (in seconds)
STATIC_CACHE_EXPIRY=31536000  # 1 year for immutable assets
HTML_CACHE_EXPIRY=3600         # 1 hour for HTML

# ================================================================
# RESOURCE LIMITS (for 2vCPU 1GB RAM)
# ================================================================
# These are soft limits - adjust based on actual needs

# Nginx limits
NGINX_CPU_LIMIT=0.3
NGINX_MEMORY_LIMIT=64M

# Backend limits
BACKEND_CPU_LIMIT=0.7
BACKEND_MEMORY_LIMIT=384M

# Frontend limits
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=256M

# Database limits
DB_CPU_LIMIT=0.5
DB_MEMORY_LIMIT=256M

# Certbot limits
CERTBOT_CPU_LIMIT=0.1
CERTBOT_MEMORY_LIMIT=64M

# ================================================================
# FEATURE FLAGS (for future use)
# ================================================================
# Enable/disable features
ENABLE_API_SWAGGER=no           # Swagger docs endpoint
ENABLE_HEALTH_CHECK=yes         # /health endpoint
ENABLE_METRICS=no               # Prometheus metrics (future)
ENABLE_TRACING=no               # Distributed tracing (future)

# ================================================================
# CUSTOM CONFIGURATION
# ================================================================
# Add any custom environment variables below

# Example: Custom API timeout
# API_TIMEOUT_SECONDS=30

# Example: Custom database connection pool size
# CONNECTION_POOL_SIZE=10

# ================================================================
# IMPORTANT NOTES
# ================================================================
# 1. NEVER commit this file to GitHub
#    - It contains sensitive information (passwords, secrets)
#    - Add .env to .gitignore
#
# 2. Keep this file secure on your VM
#    - Restrict permissions: chmod 600 .env
#    - Only owner should read/write
#
# 3. Backup your .env file separately
#    - It's not in version control
#    - Store backup in secure location
#
# 4. Update POSTGRES_PASSWORD to something strong
#    - Use mix of uppercase, lowercase, numbers, symbols
#    - Min 16 characters recommended
#    - Example: C0mplex!P@ssw0rd123$Secure
#
# 5. Update DOMAIN to your actual domain
#    - Use your registered domain name
#    - Both DOMAIN and DOMAIN_ALT if using www subdomain
#
# 6. Update LETSENCRYPT_EMAIL
#    - Used for SSL certificate notifications
#    - Choose email you monitor regularly
#
# 7. When deploying to production:
#    - Change all default values
#    - Use strong passwords
#    - Enable all security features
#    - Test thoroughly before going live

# ================================================================
# TESTING THE CONFIGURATION
# ================================================================
# After filling in values, test with:
#   source .env
#   echo $POSTGRES_PASSWORD
#   echo $DOMAIN
# 
# Should output your actual values without quotes